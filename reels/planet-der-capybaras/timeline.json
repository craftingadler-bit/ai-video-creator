 "total": 61.24,
 "scenes": [
  {
   "id": "s1",
   "title": "Hook",
   "bild": "Labor bei Nacht, Alarmlicht, Titel PLANET DER CAPYBARAS, Capybara-Gesicht mit leuchtenden Augen",
   "voStart": 0.25,
   "voEnd": 4.005,
   "vo": "Was wäre, wenn Planet der Affen real wäre? Nur mit Capybaras.",
   "start": 0,
   "end": 4.015
  },
  {
   "id": "s2",
   "title": "Tag eins",
   "bild": "Labor, Käfig, Gehirn leuchtet, Tür springt auf, Capybara legt sich hin, Zzz",
   "voStart": 4.025,
   "voEnd": 10.465,
   "vo": "Tag eins. Im Labor wird ein Capybara plötzlich schlau. Es knackt den Käfig. Und legt sich wieder hin.",
   "start": 4.015,
   "end": 10.465
  },
  {
   "id": "s3",
   "title": "Fakt",
   "bild": "Blueprint-Größenvergleich Hamster / Capybara / Mensch, Waage 60 kg, Stressmeter auf 0",
   "voStart": 10.465,
   "voEnd": 17.22,
   "vo": "Kurzer Fakt: Capybaras sind die größten Nagetiere überhaupt. Bis zu sechzig Kilo. Stresslevel: null.",
   "start": 10.465,
   "end": 17.23
  },
  {
   "id": "s4",
   "title": "Heimat",
   "bild": "Echte Karte, Kamera auf Südamerika, Verbreitungsländer färben sich von Nord nach Süd",
   "voStart": 17.24,
   "voEnd": 21.8,
   "vo": "Ihre Heimat: Südamerika. Von Venezuela bis runter nach Argentinien.",
   "start": 17.23,
   "end": 21.87
  },
  {
   "id": "s5",
   "title": "Woche eins",
   "bild": "Route Südamerika → Florida mit Capybara-Kopf, Zoom auf Florida, Pin \"seit den 90ern\"",
   "voStart": 21.94,
   "voEnd": 26.582,
   "vo": "Woche eins: Sie machen sich auf nach Florida. Und ja: Da leben echt schon wilde Capybaras.",
   "start": 21.87,
   "end": 26.592
  },
  {
   "id": "s6",
   "title": "Monat eins",
   "bild": "Route über den Atlantik nach Deutschland, schwimmender Capybara-Kopf, Luft-Timer 5:00",
   "voStart": 26.602,
   "voEnd": 32.03,
   "vo": "Monat eins: Europa. Den Atlantik schwimmen sie einfach. Tauchen können sie eh fünf Minuten.",
   "start": 26.592,
   "end": 32.25
  },
  {
   "id": "s7",
   "title": "Deutschland",
   "bild": "Deutschland leuchtet auf, Kreuz über Bundestag, Therme bei Nacht mit Dampf, Capybaras mit Orange auf dem Kopf",
   "voStart": 32.47,
   "voEnd": 38.225,
   "vo": "Monat zwei: Sie erobern Deutschland. Erstes Ziel? Nicht der Bundestag. Die Therme.",
   "start": 32.25,
   "end": 38.235
  },
  {
   "id": "s8",
   "title": "Kein Krieg",
   "bild": "Du sitzt im Becken, Capybara rutscht ran, Close-up: dein Gesicht entspannt sich komplett",
   "voStart": 38.245,
   "voEnd": 44.28,
   "vo": "Im Film gäbe es jetzt Krieg. Hier? Ein Capybara setzt sich neben dich. Und du willst nie wieder weg.",
   "start": 38.235,
   "end": 44.37
  },
  {
   "id": "s9",
   "title": "Ausbilder",
   "bild": "Büro, Capybara mit Krawatte am Schreibtisch, Hausarbeit, Stempel 1,0",
   "voStart": 44.46,
   "voEnd": 49.287,
   "vo": "Dein Ausbilder ist jetzt auch eins. Feedback zur Hausarbeit: Chill mal. Note: Eins.",
   "start": 44.37,
   "end": 49.297
  },
  {
   "id": "s10",
   "title": "Jahr eins",
   "bild": "Weltkarte färbt sich Land für Land braun, dann schlafende Capybaras, Zzz",
   "voStart": 49.307,
   "voEnd": 55.295,
   "vo": "Jahr eins: Der Planet gehört den Capybaras. Keine Kriege mehr. Nur noch Mittagsschlaf.",
   "start": 49.297,
   "end": 55.345
  },
  {
   "id": "s11",
   "title": "CTA",
   "bild": "Handy, Teilen-Dialog, Capybara-Foto",
   "voStart": 55.395,
   "voEnd": 60.19,
   "vo": "Ehrlich? Klingt besser als jetzt. Schick das an jemanden, der ein Capybara ist.",
   "start": 55.345,
   "end": 61.24
  }
 ],
