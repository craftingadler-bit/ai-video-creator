{
 "total": 55.635,
 "scenes": [
  {
   "id": "s1",
   "title": "Hook",
   "bild": "Lorbeerkranz + Säule, Titel knallt rein, SPQR-Banner",
   "voStart": 0.25,
   "voEnd": 3.13225,
   "vo": "Was wäre, wenn das Römische Reich nie untergegangen wäre?",
   "start": 0,
   "end": 3.242
  },
  {
   "id": "s2",
   "title": "Die Karte",
   "bild": "Karte färbt sich rot, Region für Region, Stern auf Rom",
   "voStart": 3.35225,
   "voEnd": 8.573395833333333,
   "vo": "Dann gehört Rom ganz Europa. Plus Nordafrika. Plus halb Asien. Hauptstadt: Rom. Überraschung.",
   "start": 3.242,
   "end": 8.683
  },
  {
   "id": "s3",
   "title": "Germania",
   "bild": "Ortsschild GERMANIA, Stempel PROVINZ",
   "voStart": 8.793395833333333,
   "voEnd": 13.7673125,
   "vo": "Deutschland gibt's nicht. Du wohnst in Germania. Und zwar in der Provinz. Wortwörtlich.",
   "start": 8.683,
   "end": 13.877
  },
  {
   "id": "s4",
   "title": "Latein",
   "bild": "Student mit Sprechblase \"Salve!\", Zeugnis Latinum, Häkchen SINN",
   "voStart": 13.9873125,
   "voEnd": 18.1633125,
   "vo": "Alle reden Latein. Endlich hätte dein Großes Latinum mal einen Sinn.",
   "start": 13.877,
   "end": 18.273
  },
  {
   "id": "s5",
   "title": "Bürokratie",
   "bild": "Schriftrolle Antrag, Bote läuft über Karte, Zähler 3 Jahre",
   "voStart": 18.3833125,
   "voEnd": 24.844395833333333,
   "vo": "Bürokratie haben die Römer quasi erfunden. Dein Antrag reist per Bote nach Rom. Bearbeitungszeit: drei Jahre.",
   "start": 18.273,
   "end": 24.954
  },
  {
   "id": "s6",
   "title": "Bahn",
   "bild": "Anzeigetafel VIA APPIA EXPRESS, Verspätung +200 Jahre",
   "voStart": 25.064395833333332,
   "voEnd": 29.40445833333333,
   "vo": "Die Bahn heißt jetzt Via Appia Express. Verspätung: zwei Jahrhunderte.",
   "start": 24.954,
   "end": 29.514
  },
  {
   "id": "s7",
   "title": "Duales Studium",
   "bild": "Kolosseum, dann Helm auf Student, Ausbilder mit Helmbusch",
   "voStart": 29.624458333333333,
   "voEnd": 35.74766666666667,
   "vo": "Duales Studium? Theoriephase im Kolosseum. Praxisphase bei der Legion. Dein Ausbilder heißt Centurio.",
   "start": 29.514,
   "end": 35.858
  },
  {
   "id": "s8",
   "title": "Freizeit",
   "bild": "Scoreboard, VAR-Bildschirm, riesiger Daumen dreht nach unten",
   "voStart": 35.967666666666666,
   "voEnd": 41.47033333333333,
   "vo": "Freitagabend: Wagenrennen statt Bundesliga. Den Videobeweis macht der Kaiser. Mit dem Daumen.",
   "start": 35.858,
   "end": 41.58
  },
  {
   "id": "s9",
   "title": "Mathe",
   "bild": "Tafel XL ÷ XII = ???, Stempel",
   "voStart": 41.690333333333335,
   "voEnd": 46.38125,
   "vo": "Und Mathe läuft in römischen Zahlen. Teil mal vierzig durch zwölf. Viel Spaß.",
   "start": 41.58,
   "end": 46.491
  },
  {
   "id": "s10",
   "title": "Fazit",
   "bild": "Säule steht, Zähler 2000 Jahre, Praxisbericht zerbröselt, Stempel NICHT",
   "voStart": 46.60125,
   "voEnd": 51.632354166666666,
   "vo": "Fazit: Das Imperium hätte zweitausend Jahre überlebt. Dein Praxisbericht trotzdem nicht.",
   "start": 46.491,
   "end": 51.742
  },
  {
   "id": "s11",
   "title": "CTA",
   "bild": "Kommentarfeld, Pfeil nach unten",
   "voStart": 51.852354166666665,
   "voEnd": 54.734874999999995,
   "vo": "In welcher Provinz würdest du wohnen? Ab in die Kommentare.",
   "start": 51.742,
   "end": 55.635
  }
 ],
