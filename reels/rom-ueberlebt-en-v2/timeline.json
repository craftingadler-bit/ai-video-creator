{
 "total": 82.553,
 "scenes": [
  {
   "id": "s1",
   "title": "Hook",
   "bild": "Columns, laurel wreath, SPQR, title slams in",
   "voStart": 0.47,
   "voEnd": 5.17,
   "vo": "What if the Roman Empire never fell? Like, never. Not even a little.",
   "start": 0,
   "end": 5.46
  },
  {
   "id": "s2",
   "title": "The map",
   "bild": "Real map, regions fill red word by word, star on Rome",
   "voStart": 5.75,
   "voEnd": 13.52,
   "vo": "Then Rome owns all of Europe, North Africa, and half of Asia. And the capital? Rome. Shocking. Truly nobody saw that coming.",
   "start": 5.46,
   "end": 13.885
  },
  {
   "id": "s3",
   "title": "Germania",
   "bild": "Town sign GERMANY crossed out, GERMANIA, stamp PROVINCE, population card",
   "voStart": 14.25,
   "voEnd": 21.63,
   "vo": "Germany doesn't exist. You live in Germania. A province. Literally. Population: twelve people and a lot of cows.",
   "start": 13.885,
   "end": 21.95
  },
  {
   "id": "s4",
   "title": "Latin",
   "bild": "Student says SALVE, Latin certificate, stamp WORTH IT",
   "voStart": 22.27,
   "voEnd": 28.57,
   "vo": "Everyone speaks Latin. Your waiter, your landlord, your ex. All those Latin classes finally paid off.",
   "start": 21.95,
   "end": 28.825
  },
  {
   "id": "s5",
   "title": "Bureaucracy",
   "bild": "Scroll FORM XIV, © ROME stamp, real map route Germania → Rome, counter 3 years",
   "voStart": 29.08,
   "voEnd": 38.56,
   "vo": "The Romans basically invented bureaucracy. Your form travels to Rome by messenger. On foot. Over the Alps. Processing time: three years.",
   "start": 28.825,
   "end": 38.83
  },
  {
   "id": "s6",
   "title": "Train",
   "bild": "Departure board VIA APPIA EXPRESS, delay +200 years",
   "voStart": 39.1,
   "voEnd": 45.9,
   "vo": "The train is now the Via Appia Express. Delay: two centuries. Still beats German trains.",
   "start": 38.83,
   "end": 46.15
  },
  {
   "id": "s7",
   "title": "College",
   "bild": "Colosseum, student with helmet, centurion boss",
   "voStart": 46.4,
   "voEnd": 53.36,
   "vo": "College? Lectures at the Colosseum. Internship with the legion. Your boss is a centurion. And he does not do home office.",
   "start": 46.15,
   "end": 53.64
  },
  {
   "id": "s8",
   "title": "Free time",
   "bild": "Scoreboard, video review, giant thumb turns down",
   "voStart": 53.92,
   "voEnd": 61.28,
   "vo": "Friday night: chariot races instead of football. Video review? Done by the emperor. With his thumb. No appeals.",
   "start": 53.64,
   "end": 61.61
  },
  {
   "id": "s9",
   "title": "Math",
   "bild": "Chalkboard XL ÷ XII = ?, stamp GOOD LUCK",
   "voStart": 61.94,
   "voEnd": 67.57,
   "vo": "And math is all in Roman numerals. Try dividing forty by twelve. Good luck. I'll wait.",
   "start": 61.61,
   "end": 67.915
  },
  {
   "id": "s10",
   "title": "Bottom line",
   "bild": "Column, counter 2,000 years, report falls, stamp NOT DONE",
   "voStart": 68.26,
   "voEnd": 74.92,
   "vo": "Bottom line: the empire would survive two thousand years. Your internship report? Still not done.",
   "start": 67.915,
   "end": 75.44
  },
  {
   "id": "s11",
   "title": "CTA",
   "bild": "Comment field, arrow down",
   "voStart": 75.96,
   "voEnd": 81.26,
   "vo": "Which province would you live in? Tell me in the comments. I'm taking Germania Inferior.",
   "start": 75.44,
   "end": 82.553
  }
 ],
