{
  "name": "ai-video-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install chromium && node kit/build-geo.mjs && node kit/build-vendor.mjs && node kit/setup-check.mjs",
    "check-setup": "node kit/setup-check.mjs",
    "geo": "node kit/build-geo.mjs",
    "vendor": "node kit/build-vendor.mjs",
    "lint": "node kit/lint-script.mjs --all",
    "report": "node kit/report.mjs",
    "test": "node --test test/*.test.mjs",
    "review": "node kit/review.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "gsap": "^3.15.1",
    "lottie-web": "^5.13.0",
    "playwright": "^1.49.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
